    {
      "parameters": {
        "jsCode": "const body = $json.body ?? $json;\nconst title = (body.title || '').trim();\nconst priority = (body.priority || 'normal').toLowerCase();\n\nif (!title) {\n  throw new Error('title alanı zorunludur.');\n}\n\nconst normalizedPriority = ['low', 'normal', 'high', 'critical'].includes(priority)\n  ? priority\n  : 'normal';\n\nreturn [{\n  title,\n  description: (body.description || '').trim(),\n  priority: normalizedPriority,\n  createdAt: new Date().toISOString(),\n  source: body.source || 'webhook'\n}];"
      },
      "id": "2",
      "name": "Normalize Payload",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        500,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": false,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "if-1",
              "leftValue": "={{$json.priority}}",
              "rightValue": "high",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            },
            {
              "id": "if-2",
              "leftValue": "={{$json.priority}}",
              "rightValue": "critical",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
